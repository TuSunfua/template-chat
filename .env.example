NEXTAUTH_SECRET="replace-with-random-32-byte-hex"
NEXTAUTH_URL="http://localhost:3000"
DATABASE_URL="mongodb+srv://<user>:<password>@<host>/<db>?retryWrites=true&w=majority"
OPENAI_API_KEY="replace-with-your-openrouter-api-key"
# Optional: any OpenAI-compatible endpoint. Defaults to OpenRouter (free tier).
# Examples: https://openrouter.ai/api/v1 | https://api.openai.com/v1
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# Optional: model id for the chosen provider. Defaults to a free OpenRouter model.
# OpenRouter free examples: nvidia/nemotron-3-super-120b-a12b:free | poolside/laguna-s-2.1:free
OPENAI_CHAT_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
UPLOADTHING_TOKEN="replace-with-your-uploadthing-token"
# Optional: set this when automatic callback URL detection is incorrect (proxy/tunnel/deployment setups).
UPLOADTHING_CALLBACK_URL="http://localhost:3000/api/uploadthing"
